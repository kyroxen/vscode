{
	"name": "intellij-experience",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.1.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": { "vscode": "^1.146.0" },
	"categories": ["Keymaps", "Themes"],
	"capabilities": {
		"untrustedWorkspaces": { "supported": true },
		"virtualWorkspaces": true
	},
	"contributes": {
		"themes": [{
			"label": "IntelliJ Islands Dark",
			"uiTheme": "vs-dark",
			"path": "./themes/intellij-islands-dark-color-theme.json"
		}],
		"configurationDefaults": {
			"workbench.colorTheme": "Dark Modern",
			"workbench.iconTheme": "vs-seti",
			"workbench.colorCustomizations": {
				"[Dark Modern]": {
					"editor.background": "#18191C",
					"breadcrumb.background": "#222429",
					"editorGroupHeader.border": "#3A3D43"
				},
				"[IntelliJ Islands Dark]": {
					"editor.background": "#18191C",
					"breadcrumb.background": "#222429",
					"editorGroupHeader.border": "#3A3D43"
				}
			},
			"workbench.editor.enablePreview": false,
			"workbench.editor.enablePreviewFromQuickOpen": false,
			"editor.multiCursorModifier": "alt",
			"editor.definitionLinkOpensInPeek": false,
			"breadcrumbs.enabled": true,
			"search.quickOpen.includeSymbols": true,
			"[javascript]": {
				"editor.gotoLocation.multipleDefinitions": "pick",
				"editor.gotoLocation.multipleDeclarations": "pick",
				"editor.gotoLocation.multipleTypeDefinitions": "pick",
				"editor.gotoLocation.multipleImplementations": "pick",
				"editor.gotoLocation.multipleReferences": "pick"
			},
			"[javascriptreact]": {
				"editor.gotoLocation.multipleDefinitions": "pick",
				"editor.gotoLocation.multipleDeclarations": "pick",
				"editor.gotoLocation.multipleTypeDefinitions": "pick",
				"editor.gotoLocation.multipleImplementations": "pick",
				"editor.gotoLocation.multipleReferences": "pick"
			},
			"[typescript]": {
				"editor.gotoLocation.multipleDefinitions": "pick",
				"editor.gotoLocation.multipleDeclarations": "pick",
				"editor.gotoLocation.multipleTypeDefinitions": "pick",
				"editor.gotoLocation.multipleImplementations": "pick",
				"editor.gotoLocation.multipleReferences": "pick"
			},
			"[typescriptreact]": {
				"editor.gotoLocation.multipleDefinitions": "pick",
				"editor.gotoLocation.multipleDeclarations": "pick",
				"editor.gotoLocation.multipleTypeDefinitions": "pick",
				"editor.gotoLocation.multipleImplementations": "pick",
				"editor.gotoLocation.multipleReferences": "pick"
			},
			"[java]": {
				"editor.gotoLocation.multipleDefinitions": "pick",
				"editor.gotoLocation.multipleDeclarations": "pick",
				"editor.gotoLocation.multipleTypeDefinitions": "pick",
				"editor.gotoLocation.multipleImplementations": "pick",
				"editor.gotoLocation.multipleReferences": "pick"
			}
		},
		"keybindings": [{
			"key": "ctrl+alt+f7",
			"mac": "cmd+alt+f7",
			"command": "editor.action.goToReferences",
			"when": "editorTextFocus && editorHasReferenceProvider && !inReferenceSearchEditor"
		}, {
			"key": "shift shift",
			"command": "workbench.action.intellijSearchEverywhere",
			"when": "!terminalFocus && !inputFocus"
		}, {
			"key": "ctrl+n",
			"mac": "cmd+o",
			"command": "intellij.goToClass",
			"when": "!terminalFocus && !inputFocus"
		}, {
			"key": "ctrl+n",
			"mac": "cmd+o",
			"command": "workbench.action.showAllSymbols",
			"when": "!terminalFocus && !inputFocus && editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact)$/"
		}, {
			"key": "ctrl+alt+shift+n",
			"mac": "cmd+alt+o",
			"command": "workbench.action.showAllSymbols",
			"when": "!terminalFocus && !inputFocus"
		}, {
			"key": "ctrl+shift+b",
			"mac": "cmd+shift+b",
			"command": "editor.action.goToTypeDefinition",
			"when": "editorTextFocus && editorHasTypeDefinitionProvider"
		}]
	}
}
